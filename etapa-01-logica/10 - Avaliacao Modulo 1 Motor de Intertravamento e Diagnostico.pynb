        "{\n",
        " \"cells\": [\n",
        "  {\n",
        "   \"cell_type\": \"markdown\",\n",
        "   \"metadata\": {},\n",
        "   \"source\": [\n",
        "    \"# Aula 10 - Notebook: Avaliação Integrada do Módulo 1 — SCADA-Core Segurança & Diagnóstico\\n\",\n",
        "    \"\\n\",\n",
        "    \"Este notebook integra todos os componentes desenvolvidos no **Módulo 1**: telemetria de sensores, discretização proposicional, prova de tautologias de segurança e motor especialista de inferência aplicado à Máquina de Envasamento de Copos.\\n\"\n",
        "   ]\n",
        "  },\n",
        "  {\n",
        "   \"cell_type\": \"code\",\n",
        "   \"execution_count\": 1,\n",
        "   \"metadata\": {},\n",
        "   \"outputs\": [\n",
        "    {\n",
        "     \"name\": \"stdout\",\n",
        "     \"output_type\": \"stream\",\n",
        "     \"text\": [\n",
        "      \"[OK] Classes Base do SCADA-Core carregadas!\\n\"\n",
        "     ]\n",
        "    }\n",
        "   ],\n",
        "   \"source\": [\n",
        "    \"def formatar_tabela(dados):\\n\",\n",
        "    \"    \\\"\\\"\\\"Formata lista de dicionarios em tabela ASCII pura.\\\"\\\"\\\"\\n\",\n",
        "    \"    if not dados:\\n\",\n",
        "    \"        return \\\"Tabela Vazia\\\"\\n\",\n",
        "    \"    colunas = list(dados[0].keys())\\n\",\n",
        "    \"    larguras = {c: len(str(c)) for c in colunas}\\n\",\n",
        "    \"    for row in dados:\\n\",\n",
        "    \"        for c in colunas:\\n\",\n",
        "    \"            larguras[c] = max(larguras[c], len(str(row.get(c, \\\"\\\"))))\\n\",\n",
        "    \"    header = \\\" | \\\".join(f\\\"{c:<{larguras[c]}}\\\" for c in colunas)\\n\",\n",
        "    \"    divisor = \\\"-+-\\\".join(\\\"-\\\" * larguras[c] for c in colunas)\\n\",\n",
        "    \"    linhas = [header, divisor]\\n\",\n",
        "    \"    for row in dados:\\n\",\n",
        "    \"        linhas.append(\\\" | \\\".join(f\\\"{str(row.get(c, '')):<{larguras[c]}}\\\" for c in colunas))\\n\",\n",
        "    \"    return \\\"\\\\n\\\".join(linhas)\\n\",\n",
        "    \"\\n\",\n",
        "    \"from dataclasses import dataclass\\n\",\n",
        "    \"from typing import Dict, List, Set, Tuple, Any\\n\",\n",
        "    \"\\n\",\n",
        "    \"class MapeadorProposicional:\\n\",\n",
        "    \"    def extrair_proposicoes(self, telemetria: Dict[str, float]) -> Dict[str, bool]:\\n\",\n",
        "    \"        tem_copo = bool(telemetria.get('Sensor_Capacitivo', 0))\\n\",\n",
        "    \"        t1_atingida = telemetria.get('Temp_Termosselagem', 0.0) >= 180.0\\n\",\n",
        "    \"        return {\\n\",\n",
        "    \"            'tem_copo': tem_copo,\\n\",\n",
        "    \"            'falta_copo': not tem_copo,\\n\",\n",
        "    \"            't1': t1_atingida,\\n\",\n",
        "    \"            'baixa_temp': not t1_atingida,\\n\",\n",
        "    \"            'e1': bool(telemetria.get('Botao_Emergencia', 0)),\\n\",\n",
        "    \"            'mesa_posicionada': bool(telemetria.get('Sensor_Posicao_Mesa', 1)),\\n\",\n",
        "    \"        }\\n\",\n",
        "    \"\\n\",\n",
        "    \"@dataclass\\n\",\n",
        "    \"class RegraProducao:\\n\",\n",
        "    \"    id_regra: str\\n\",\n",
        "    \"    antecedentes: Set[str]\\n\",\n",
        "    \"    consequente: str\\n\",\n",
        "    \"    descricao_diagnostico: str\\n\",\n",
        "    \"    prioridade: int = 1\\n\",\n",
        "    \"\\n\",\n",
        "    \"class BaseConhecimento:\\n\",\n",
        "    \"    def __init__(self):\\n\",\n",
        "    \"        self.regras: List[RegraProducao] = []\\n\",\n",
        "    \"    def adicionar_regra(self, id_r, antecedentes, consequente, desc, prioridade=1):\\n\",\n",
        "    \"        self.regras.append(RegraProducao(id_r, set(antecedentes), consequente, desc, prioridade))\\n\",\n",
        "    \"\\n\",\n",
        "    \"class MotorInferencia:\\n\",\n",
        "    \"    def __init__(self, base_conhecimento):\\n\",\n",
        "    \"        self.bc = base_conhecimento\\n\",\n",
        "    \"    def forward_chaining(self, fatos_iniciais):\\n\",\n",
        "    \"        fatos_conhecidos = set(fatos_iniciais)\\n\",\n",
        "    \"        historico = []\\n\",\n",
        "    \"        passo = 1\\n\",\n",
        "    \"        novos = True\\n\",\n",
        "    \"        while novos:\\n\",\n",
        "    \"            novos = False\\n\",\n",
        "    \"            for regra in sorted(self.bc.regras, key=lambda r: r.prioridade, reverse=True):\\n\",\n",
        "    \"                if regra.antecedentes.issubset(fatos_conhecidos) and regra.consequente not in fatos_conhecidos:\\n\",\n",
        "    \"                    fatos_conhecidos.add(regra.consequente)\\n\",\n",
        "    \"                    historico.append({\\\"Passo\\\": passo, \\\"Regra\\\": regra.id_regra, \\\"Diagnóstico\\\": regra.descricao_diagnostico})\\n\",\n",
        "    \"                    passo += 1\\n\",\n",
        "    \"                    novos = True\\n\",\n",
        "    \"                    break\\n\",\n",
        "    \"        return fatos_conhecidos, historico\\n\",\n",
        "    \"\\n\",\n",
        "    \"print(\\\"[OK] Classes Base do SCADA-Core carregadas!\\\")\\n\"\n",
        "   ]\n",
        "  },\n",
        "  {\n",
        "   \"cell_type\": \"code\",\n",
        "   \"execution_count\": 2,\n",
        "   \"metadata\": {},\n",
        "   \"outputs\": [\n",
        "    {\n",
        "     \"name\": \"stdout\",\n",
        "     \"output_type\": \"stream\",\n",
        "     \"text\": [\n",
        "      \"=== AVALIAÇÃO DE INTERTRAVAMENTOS (MÓDULO 1) ===\\n\",\n",
        "      \"-> Cenário A (Falta Copo) | Trip: True | Infere: True\\n\",\n",
        "      \"-> Cenário B (Frio)       | Trip: True | Infere: True\\n\",\n",
        "      \"-> Cenário C (Normal)     | Trip: False | Infere: True\\n\",\n",
        "      \"\\n\",\n",
        "      \"[OK] Avaliação Módulo 1 concluída com 100% de sucesso na Envasadora!\\n\"\n",
        "     ]\n",
        "    }\n",
        "   ],\n",
        "   \"source\": [\n",
        "    \"class SCADACoreEnvasadora:\\n\",\n",
        "    \"    def __init__(self):\\n\",\n",
        "    \"        self.mapeador = MapeadorProposicional()\\n\",\n",
        "    \"        self.bc = BaseConhecimento()\\n\",\n",
        "    \"        \\n\",\n",
        "    \"        self.bc.adicionar_regra(\\\"R-01\\\", [\\\"e1\\\"], \\\"parada_imediata\\\", \\\"Botão de Emergência Acionado\\\", 10)\\n\",\n",
        "    \"        self.bc.adicionar_regra(\\\"R-02\\\", [\\\"falta_copo\\\"], \\\"alarme_sem_copo\\\", \\\"Falta de Copo na Dispensação\\\", 9)\\n\",\n",
        "    \"        self.bc.adicionar_regra(\\\"R-03\\\", [\\\"alarme_sem_copo\\\"], \\\"bloqueia_dosador\\\", \\\"Bico Bloqueado (Cascata)\\\", 8)\\n\",\n",
        "    \"        self.bc.adicionar_regra(\\\"R-04\\\", [\\\"tem_copo\\\", \\\"baixa_temp\\\"], \\\"bloqueia_prensa\\\", \\\"Bloqueio Térmico da Selagem\\\", 8)\\n\",\n",
        "    \"        self.bc.adicionar_regra(\\\"R-05\\\", [\\\"tem_copo\\\", \\\"t1\\\"], \\\"libera_prensa\\\", \\\"Condições Ideais para Selagem\\\", 5)\\n\",\n",
        "    \"        \\n\",\n",
        "    \"        self.motor = MotorInferencia(self.bc)\\n\",\n",
        "    \"        \\n\",\n",
        "    \"    def processar_ciclo_scan(self, telemetria: Dict[str, float]) -> Dict[str, Any]:\\n\",\n",
        "    \"        props = self.mapeador.extrair_proposicoes(telemetria)\\n\",\n",
        "    \"        fatos_ativos = {k for k, v in props.items() if v}\\n\",\n",
        "    \"        \\n\",\n",
        "    \"        trip = props['e1'] or props['falta_copo'] or (props['tem_copo'] and props['baixa_temp'])\\n\",\n",
        "    \"        \\n\",\n",
        "    \"        fatos_inf, trilha = self.motor.forward_chaining(fatos_ativos)\\n\",\n",
        "    \"        return {\\n\",\n",
        "    \"            \\\"Trip_Ativo\\\": trip,\\n\",\n",
        "    \"            \\\"Diagnósticos\\\": list(fatos_inf),\\n\",\n",
        "    \"            \\\"Trilha\\\": trilha\\n\",\n",
        "    \"        }\\n\",\n",
        "    \"\\n\",\n",
        "    \"core_maquina = SCADACoreEnvasadora()\\n\",\n",
        "    \"\\n\",\n",
        "    \"res_a = core_maquina.processar_ciclo_scan({'Sensor_Capacitivo': 0.0, 'Temp_Termosselagem': 185.0, 'Botao_Emergencia': 0.0})\\n\",\n",
        "    \"res_b = core_maquina.processar_ciclo_scan({'Sensor_Capacitivo': 1.0, 'Temp_Termosselagem': 160.0, 'Botao_Emergencia': 0.0})\\n\",\n",
        "    \"res_c = core_maquina.processar_ciclo_scan({'Sensor_Capacitivo': 1.0, 'Temp_Termosselagem': 182.0, 'Botao_Emergencia': 0.0})\\n\",\n",
        "    \"\\n\",\n",
        "    \"print(\\\"=== AVALIAÇÃO DE INTERTRAVAMENTOS (MÓDULO 1) ===\\\")\\n\",\n",
        "    \"print(f\\\"-> Cenário A (Falta Copo) | Trip: {res_a['Trip_Ativo']} | Infere: {'bloqueia_dosador' in res_a['Diagnósticos']}\\\")\\n\",\n",
        "    \"print(f\\\"-> Cenário B (Frio)       | Trip: {res_b['Trip_Ativo']} | Infere: {'bloqueia_prensa' in res_b['Diagnósticos']}\\\")\\n\",\n",
        "    \"print(f\\\"-> Cenário C (Normal)     | Trip: {res_c['Trip_Ativo']} | Infere: {'libera_prensa' in res_c['Diagnósticos']}\\\")\\n\",\n",
        "    \"\\n\",\n",
        "    \"assert res_a[\\\"Trip_Ativo\\\"] is True\\n\",\n",
        "    \"assert \\\"alarme_sem_copo\\\" in res_a[\\\"Diagnósticos\\\"]\\n\",\n",
